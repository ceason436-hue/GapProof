DATABASE_URL=postgres://gapproof:gapproof_local@127.0.0.1:55432/gapproof
TEST_DATABASE_URL=postgres://gapproof:gapproof_local@127.0.0.1:55432/gapproof
API_PORT=4000
WEB_PORT=3000
GAPPROOF_DEMO_STUDENT_ID=0198b111-1111-7000-8000-0000000000d2
GAPPROOF_UPLOAD_DIR=
GAPPROOF_UPLOAD_SIGNING_SECRET=
GAPPROOF_DEVICE_SESSION_SECRET=

# Source asset storage. Development may use local; production must use s3.
GAPPROOF_STORAGE_DRIVER=local
GAPPROOF_S3_ENDPOINT=
GAPPROOF_S3_BUCKET=
GAPPROOF_S3_REGION=
# Keep s3 unless the selected compatibility gateway documents another SigV4 service name.
GAPPROOF_S3_SERVICE=s3
GAPPROOF_S3_ACCESS_KEY_ID=
GAPPROOF_S3_SECRET_ACCESS_KEY=
GAPPROOF_S3_SESSION_TOKEN=

# Development-only Alibaba OCR smoke test. Put real values in ignored .env only.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
ALIBABA_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# Development-only DeepSeek provider spike. Put the real key in ignored .env only.
GAPPROOF_DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=30000
