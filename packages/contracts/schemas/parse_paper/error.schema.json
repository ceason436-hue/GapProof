{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "code",
    "message",
    "retryable"
  ],
  "properties": {
    "code": {
      "minLength": 1,
      "type": "string"
    },
    "message": {
      "minLength": 1,
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "providerCode": {
      "type": "string"
    },
    "details": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {}
      }
    }
  }
}
